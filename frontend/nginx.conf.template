resolver 127.0.0.11 ipv6=off valid=10s;

# Rate limit tecnico anti-flood (nao e cota de negocio: o uso e ilimitado).
limit_req_zone $binary_remote_addr zone=formatar:10m rate=60r/m;

# Confia no X-Forwarded-For vindo de redes privadas (nginx do host) para limitar por IP real.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 25m;

    location /formatar {
        limit_req zone=formatar burst=20 nodelay;
        limit_req_status 429;

        set $api http://${API_HOST}:${API_PORT};
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /health {
        set $api http://${API_HOST}:${API_PORT};
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /admin {
        try_files /admin.html =404;
    }

    location = /admin/ {
        return 301 /admin;
    }

    location /admin/ {
        set $api http://${API_HOST}:${API_PORT};
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
