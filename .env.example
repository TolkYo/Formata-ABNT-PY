# Configuração da API (Fase 1)
APP_NAME=Formatador ABNT API
APP_VERSION=1.0.0

# Limite de upload em MB
MAX_UPLOAD_MB=20

# Cota anônima por IP (janela de 24h)
QUOTA_ANONIMA_DIA=3

# Origens permitidas para CORS (separadas por vírgula; use * em dev)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Opcional: cota distribuída via Redis (ex.: redis://redis:6379/0)
# REDIS_URL=redis://redis:6379/0
