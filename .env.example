# Configuração da API (Fase 1)
APP_NAME=Formatador ABNT API
APP_VERSION=1.0.0

# Limite de upload em MB
MAX_UPLOAD_MB=20

# Origem das doações (URL de apoio exibida no site). Opcional.
# Ex.: DOACOES_URL=https://github.com/sponsors/seu-usuario
DOACOES_URL=

# Origens permitidas para CORS (separadas por vírgula; use * em dev)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Fase 2: métricas e auditoria (opcional) ---
# Sem DATABASE_URL, o núcleo continua funcionando e nada é persistido.
# Ex.: DATABASE_URL=postgresql+psycopg://formatador:formatador@localhost:5432/formatador
DATABASE_URL=

# Chave do painel admin (header X-Admin-Key). Sem ela, o painel fica indisponível.
ADMIN_API_KEY=

# Sal para anonimizar o IP (hash). Troque em produção.
IP_HASH_SALT=

# Cria as tabelas no start via metadata (dev). Em produção, use Alembic.
AUTO_CRIAR_TABELAS=false

# --- Fase 2: observabilidade e alertas (opcional) ---
# Sentry: sem DSN, a integração fica desligada.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Alertas de anomalia (usam os eventos de uso; exigem DATABASE_URL).
# Webhook compatível com Slack/Discord (opcional); sem ele, alerta só no log/Sentry.
ALERTA_WEBHOOK_URL=
ALERTA_INTERVALO_MIN=15
ALERTA_JANELA_MIN=15
ALERTA_TAXA_ERRO=0.3
ALERTA_MIN_DOCUMENTOS=10
ALERTA_VOLUME_MAX=0
ALERTA_COOLDOWN_MIN=60
