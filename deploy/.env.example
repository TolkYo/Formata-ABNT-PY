# Copie para deploy/.env e ajuste antes do deploy.
#
# ATENCAO: o `docker stack deploy` NAO le .env automaticamente (isso e recurso do
# `docker compose`). Exporte as variaveis para o shell antes:
#     set -a; . ./.env; set +a
#
# A borda (80/443 + TLS) e o nginx do host com Certbot; nao ha variaveis de
# dominio/ACME aqui.

# Banco (Fase 2)
POSTGRES_PASSWORD=troque-esta-senha

# Painel admin (header X-Admin-Key)
ADMIN_API_KEY=troque-esta-chave

# Sal do hash de IP
IP_HASH_SALT=troque-este-sal

# Link de doacao exibido no site (opcional)
DOACOES_URL=

# Observabilidade / alertas (opcional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
ALERTA_WEBHOOK_URL=
