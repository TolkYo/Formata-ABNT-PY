# Copie para deploy/.env e ajuste antes do deploy.
#
# ATENCAO: o `docker stack deploy` NAO le .env automaticamente (isso e recurso do
# `docker compose`). Exporte as variaveis para o shell antes:
#     set -a; . ./.env; set +a
#
# A borda (80/443 + TLS) e o nginx do host com Certbot. O deploy manual apenas
# exporta as variaveis abaixo; o `bootstrap-hostinger.sh` tambem usa DOMAIN e
# ACME_EMAIL para configurar o nginx e emitir o certificado.

# Dominio publico e e-mail da conta ACME (Certbot). Mesmo dominio da Locaweb.
DOMAIN=formatabnt.com.br
ACME_EMAIL=seu-email@exemplo.com

# Banco (Fase 2)
POSTGRES_PASSWORD=troque-esta-senha

# Painel admin (header X-Admin-Key)
ADMIN_API_KEY=troque-esta-chave

# Sal do hash de IP
IP_HASH_SALT=troque-este-sal

# Link de doacao exibido no site (opcional)
DOACOES_URL=

# Doacao via PIX (opcional): preencha os tres para exibir QR + copia-e-cola.
# Prefira chave aleatoria (EVP) para nao expor CPF/telefone/e-mail.
PIX_CHAVE=
PIX_NOME=
PIX_CIDADE=

# Observabilidade / alertas (opcional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
ALERTA_WEBHOOK_URL=

# Fila: o stack usa estes valores seguros por padrao; ajuste somente se necessario.
FILA_MAX_JOBS=20
JOB_TIMEOUT_SEGUNDOS=180
JOB_TTL_SEGUNDOS=900
JOB_FILA_TTL_SEGUNDOS=1800
