# Copie para deploy/.env e ajuste antes de usar o stack (stack.yml ou stack-tls.yml).
# O `docker stack deploy` resolve ${VAR} a partir do ambiente; exporte estas
# variáveis (ou use `docker stack deploy --env-file .env`).

# HTTPS (stack-tls.yml)
DOMAIN=seu-dominio.com
ACME_EMAIL=voce@seu-dominio.com

# Banco (Fase 2)
POSTGRES_PASSWORD=troque-esta-senha

# Painel admin (header X-Admin-Key)
ADMIN_API_KEY=troque-esta-chave

# Sal do hash de IP
IP_HASH_SALT=troque-este-sal

# Link de doação exibido no site (opcional)
DOACOES_URL=

# Observabilidade / alertas (opcional)
SENTRY_DSN=
ALERTA_WEBHOOK_URL=
